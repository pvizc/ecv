---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { locales, type Locale } from '../i18n/content';

interface Props {
	lang: Locale;
	label: string;
}

const { lang, label } = Astro.props;
---

<nav aria-label={label}>
	<ul class="flex items-center text-sm">
		{
			locales.map((locale, i) => (
				<li class="flex items-center">
					{i > 0 && (
						<span aria-hidden="true" class="text-stone-300 dark:text-stone-700">
							|
						</span>
					)}
					<a
						href={getRelativeLocaleUrl(locale)}
						hreflang={locale}
						lang={locale}
						aria-current={locale === lang ? 'page' : undefined}
						class="rounded px-2 py-1.5 text-stone-500 transition-colors hover:text-stone-900 focus-visible:outline-2 focus-visible:outline-teal-700 aria-[current=page]:font-semibold aria-[current=page]:text-stone-900 dark:text-stone-400 dark:hover:text-stone-100 dark:aria-[current=page]:text-stone-100"
					>
						{locale}
					</a>
				</li>
			))
		}
	</ul>
</nav>
