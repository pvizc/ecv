---
import Monitor from '@lucide/astro/icons/monitor';
import Moon from '@lucide/astro/icons/moon';
import Sun from '@lucide/astro/icons/sun';
import type { Content } from '../i18n/content';

interface Props {
	labels: Content['theme'];
}

const { labels } = Astro.props;

// Los radios controlan el tema vía `html:has(...)` en global.css, así que funciona sin JavaScript.
// El script de abajo solo recuerda la elección entre visitas.
// Los ids `theme-*` los usa global.css; si los cambias, cámbialos también allí.
const options = [
	{ value: 'system', label: labels.system, icon: Monitor, checked: true },
	{ value: 'light', label: labels.light, icon: Sun },
	{ value: 'dark', label: labels.dark, icon: Moon },
];
---

<fieldset id="theme-switcher" class="flex rounded-full border border-stone-300 p-0.5 dark:border-stone-700">
	<legend class="sr-only">{labels.legend}</legend>
	{
		options.map(({ value, label, icon: Icon, checked }) => (
			<label for={`theme-${value}`} title={label} class="cursor-pointer">
				<input
					type="radio"
					name="theme"
					id={`theme-${value}`}
					value={value}
					checked={checked}
					autocomplete="off"
					class="peer sr-only"
				/>
				<span class="flex size-8 items-center justify-center rounded-full text-stone-500 transition-colors peer-checked:bg-stone-200 peer-checked:text-stone-900 peer-focus-visible:outline-2 peer-focus-visible:outline-teal-700 hover:text-stone-900 dark:text-stone-400 dark:peer-checked:bg-stone-800 dark:peer-checked:text-stone-100 dark:hover:text-stone-100">
					<Icon size={16} aria-hidden="true" />
					<span class="sr-only">{label}</span>
				</span>
			</label>
		))
	}
</fieldset>

<!-- Inline y justo después de los radios: se ejecuta antes de pintar el resto de la página, sin parpadeo. -->
<script is:inline>
	(() => {
		const key = 'theme';
		try {
			const saved = localStorage.getItem(key);
			const input = saved && document.getElementById(`theme-${saved}`);
			if (input) input.checked = true;
		} catch {}
		document.getElementById('theme-switcher').addEventListener('change', (event) => {
			try {
				localStorage.setItem(key, event.target.value);
			} catch {}
		});
	})();
</script>
