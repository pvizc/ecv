---
import Layout from '../layouts/Layout.astro';

// Datos de contacto y contenido: edita aquí.
const profile = {
	name: 'Paulo Vizcaíno',
	tagline: 'Clases particulares de inglés',
	intro:
		'Clases adaptadas a ti: a tu nivel, a tu ritmo y a lo que necesitas conseguir. Sin libros eternos ni teoría de más.',
	location: 'Madrid',
	whatsapp: '34600000000', // formato internacional, sin "+" ni espacios
	email: 'hola@example.com',
};

const offer = [
	{ title: 'Conversación', text: 'Gana fluidez y pierde el miedo a hablar.' },
	{ title: 'Exámenes oficiales', text: 'Preparación para Cambridge (B1, B2, C1), IELTS y EOI.' },
	{ title: 'Apoyo escolar', text: 'Refuerzo para primaria, ESO y bachillerato.' },
	{ title: 'Inglés profesional', text: 'Entrevistas, reuniones, emails y presentaciones.' },
];

const steps = [
	'Escríbeme y cuéntame qué buscas.',
	'Hacemos una primera clase para ver tu nivel.',
	'Fijamos horario y empezamos.',
];

const whatsappUrl = `https://wa.me/${profile.whatsapp}?text=${encodeURIComponent('Hola, me interesan las clases de inglés.')}`;
const emailUrl = `mailto:${profile.email}?subject=${encodeURIComponent('Clases de inglés')}`;
---

<Layout
	title={`${profile.name} · ${profile.tagline}`}
	description={`${profile.tagline} presenciales en ${profile.location} y online. ${profile.intro}`}
>
	<main class="mx-auto flex max-w-md flex-col gap-12 px-6 pt-14 pb-10">
		<header class="flex flex-col gap-5">
			<p class="text-sm font-medium tracking-wide text-teal-700 uppercase dark:text-teal-400">
				{profile.tagline}
			</p>
			<h1 class="text-4xl leading-tight font-semibold tracking-tight">{profile.name}</h1>
			<p class="text-lg leading-relaxed text-stone-600 dark:text-stone-400">{profile.intro}</p>
			<ul class="flex flex-wrap gap-2 text-sm">
				<li class="rounded-full border border-stone-300 px-3 py-1 dark:border-stone-700">
					Presencial · {profile.location}
				</li>
				<li class="rounded-full border border-stone-300 px-3 py-1 dark:border-stone-700">Online</li>
				<li class="rounded-full border border-stone-300 px-3 py-1 dark:border-stone-700">Todos los niveles</li>
			</ul>
		</header>

		<nav aria-label="Contacto" class="flex flex-col gap-3">
			<a
				href={whatsappUrl}
				class="flex items-center justify-center gap-2 rounded-xl bg-teal-700 px-5 py-4 text-base font-semibold text-white transition-colors hover:bg-teal-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700 dark:bg-teal-500 dark:text-stone-950 dark:hover:bg-teal-400"
			>
				<svg aria-hidden="true" viewBox="0 0 24 24" class="size-5 fill-current">
					<path
						d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2c-1.5 0-3-.4-4.3-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2c0 1.3.9 2.5 1 2.7.1.2 1.8 2.8 4.4 3.9 1.6.7 2.3.8 3.1.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.2-.2-.5-.3Z"
					></path>
				</svg>
				Escríbeme por WhatsApp
			</a>
			<a
				href={emailUrl}
				class="flex items-center justify-center rounded-xl border border-stone-300 px-5 py-4 text-base font-semibold transition-colors hover:bg-stone-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700 dark:border-stone-700 dark:hover:bg-stone-900"
			>
				{profile.email}
			</a>
		</nav>

		<section aria-labelledby="offer" class="flex flex-col gap-5">
			<h2 id="offer" class="text-xl font-semibold tracking-tight">Qué puedo ofrecerte</h2>
			<ul class="flex flex-col divide-y divide-stone-200 dark:divide-stone-800">
				{
					offer.map((item) => (
						<li class="py-3 first:pt-0 last:pb-0">
							<p class="font-medium">{item.title}</p>
							<p class="text-stone-600 dark:text-stone-400">{item.text}</p>
						</li>
					))
				}
			</ul>
		</section>

		<section aria-labelledby="steps" class="flex flex-col gap-5">
			<h2 id="steps" class="text-xl font-semibold tracking-tight">Cómo empezamos</h2>
			<ol class="flex flex-col gap-3">
				{
					steps.map((step, i) => (
						<li class="flex gap-4">
							<span class="flex size-7 shrink-0 items-center justify-center rounded-full bg-teal-700/10 text-sm font-semibold text-teal-800 dark:bg-teal-400/15 dark:text-teal-300">
								{i + 1}
							</span>
							<span class="pt-0.5">{step}</span>
						</li>
					))
				}
			</ol>
		</section>

		<footer class="border-t border-stone-200 pt-6 text-sm text-stone-500 dark:border-stone-800">
			<p>© {new Date().getFullYear()} {profile.name}</p>
		</footer>
	</main>
</Layout>
