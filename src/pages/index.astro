---
import Mail from '@lucide/astro/icons/mail';
import Github from 'simple-icons-astro/Github';
import Whatsapp from 'simple-icons-astro/Whatsapp';
import Linkedin from '../components/icons/Linkedin.astro';
import ThemeSwitcher from '../components/ThemeSwitcher.astro';
import Layout from '../layouts/Layout.astro';

// Datos de contacto y contenido: edita aquí.
const profile = {
	name: 'Paulo Vizcaíno',
	tagline: 'Clases particulares de inglés',
	intro:
		'Clases para aprobar, conseguir un título oficial y ganar soltura al hablar. A tu ritmo y centradas en lo que necesitas.',
	location: 'Ensanche de Vallecas',
	description:
		'Clases de inglés presenciales en Ensanche de Vallecas (Madrid) y online. ESO, Bachillerato, PAU, Cambridge hasta el B2 First y conversación.',
	whatsapp: '34628788166', // formato internacional, sin "+" ni espacios
	email: 'learn.english@pvizc.com',
	github: 'https://github.com/pvizc',
	linkedin: 'https://www.linkedin.com/in/pvizc/',
};

const offer = [
	{
		title: 'ESO y Bachillerato',
		text: 'Refuerzo durante el curso y preparación de exámenes y de la PAU (Selectividad).',
	},
	{
		title: 'Títulos de Cambridge',
		text: 'A2 Key, B1 Preliminary y B2 First. Un título oficial que suma en la universidad, para un Erasmus o en tu primer trabajo.',
	},
	{
		title: 'Conversación',
		text: 'Práctica sobre temas que te interesen, para ganar fluidez y confianza al hablar.',
	},
];

const steps = [
	'Escríbeme por WhatsApp y cuéntame qué necesitas.',
	'Hacemos una primera clase para conocer tu nivel.',
	'Acordamos un horario y empezamos.',
];

const about = [
	'Soy ingeniero de software y gallego, aunque llevo cinco años viviendo en Madrid. Viví una temporada en Estados Unidos, estudié en la Escuela Oficial de Idiomas y tengo el C1 Advanced de Cambridge.',
	'El inglés es mucho más que una asignatura: es la lengua en la que se comparte gran parte de lo que se investiga, se programa y se crea hoy en día. Te permite estudiar o trabajar fuera, acceder a más oportunidades y disfrutar de series, libros o música en versión original. Mi objetivo es que aprendas a usarlo de verdad, no solo para el examen.',
];

const socials = [
	{ label: 'GitHub', href: profile.github, icon: Github },
	{ label: 'LinkedIn', href: profile.linkedin, icon: Linkedin },
];

const whatsappUrl = `https://wa.me/${profile.whatsapp}?text=${encodeURIComponent('Hola, me interesan las clases de inglés.')}`;
const emailUrl = `mailto:${profile.email}?subject=${encodeURIComponent('Clases de inglés')}`;
---

<Layout title={`${profile.name} · ${profile.tagline}`} description={profile.description}>
	<main class="mx-auto flex max-w-md flex-col gap-12 px-6 pt-6 pb-10">
		<div class="flex justify-end">
			<ThemeSwitcher />
		</div>

		<header class="-mt-4 flex flex-col gap-5">
			<p class="text-sm font-medium tracking-wide text-teal-700 uppercase dark:text-teal-400">
				{profile.tagline}
			</p>
			<h1 class="text-4xl leading-tight font-semibold tracking-tight">{profile.name}</h1>
			<p class="text-lg leading-relaxed text-stone-600 dark:text-stone-400">{profile.intro}</p>
			<ul class="flex flex-wrap gap-2 text-sm">
				<li class="rounded-full border border-stone-300 px-3 py-1 dark:border-stone-700">
					Presencial · {profile.location}
				</li>
				<li class="rounded-full border border-stone-300 px-3 py-1 dark:border-stone-700">Online</li>
			</ul>
		</header>

		<nav aria-label="Contacto" class="flex flex-col gap-3">
			<a
				href={whatsappUrl}
				class="flex items-center justify-center gap-2 rounded-xl bg-teal-700 px-5 py-4 text-base font-semibold text-white transition-colors hover:bg-teal-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700 dark:bg-teal-500 dark:text-stone-950 dark:hover:bg-teal-400"
			>
				<Whatsapp size={20} fill="currentColor" aria-hidden="true" />
				Escríbeme por WhatsApp
			</a>
			<a
				href={emailUrl}
				class="flex items-center justify-center gap-2 rounded-xl border border-stone-300 px-5 py-4 text-base font-semibold transition-colors hover:bg-stone-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700 dark:border-stone-700 dark:hover:bg-stone-900"
			>
				<Mail size={20} aria-hidden="true" />
				{profile.email}
			</a>
		</nav>

		<section aria-labelledby="offer" class="flex flex-col gap-5">
			<h2 id="offer" class="text-xl font-semibold tracking-tight">En qué te ayudo</h2>
			<ul class="flex flex-col divide-y divide-stone-200 dark:divide-stone-800">
				{
					offer.map((item) => (
						<li class="py-3 first:pt-0 last:pb-0">
							<p class="font-medium">{item.title}</p>
							<p class="text-stone-600 dark:text-stone-400">{item.text}</p>
						</li>
					))
				}
			</ul>
		</section>

		<section aria-labelledby="steps" class="flex flex-col gap-5">
			<h2 id="steps" class="text-xl font-semibold tracking-tight">Cómo empezamos</h2>
			<ol class="flex flex-col gap-3">
				{
					steps.map((step, i) => (
						<li class="flex gap-4">
							<span class="flex size-7 shrink-0 items-center justify-center rounded-full bg-teal-700/10 text-sm font-semibold text-teal-800 dark:bg-teal-400/15 dark:text-teal-300">
								{i + 1}
							</span>
							<span class="pt-0.5">{step}</span>
						</li>
					))
				}
			</ol>
		</section>

		<section aria-labelledby="about" class="flex flex-col gap-5">
			<h2 id="about" class="text-xl font-semibold tracking-tight">Sobre mí</h2>
			<div class="flex flex-col gap-4 leading-relaxed text-stone-600 dark:text-stone-400">
				{about.map((paragraph) => <p>{paragraph}</p>)}
			</div>
		</section>

		<footer
			class="flex items-center justify-between border-t border-stone-200 pt-6 text-sm text-stone-500 dark:border-stone-800"
		>
			<p>© {new Date().getFullYear()} {profile.name}</p>
			<ul class="-mr-2 flex gap-1">
				{
					socials.map(({ label, href, icon: Icon }) => (
						<li>
							<a
								href={href}
								aria-label={label}
								title={label}
								rel="me noopener"
								class="flex size-10 items-center justify-center rounded-full transition-colors hover:text-stone-900 focus-visible:outline-2 focus-visible:outline-teal-700 dark:hover:text-stone-100"
							>
								<Icon size={20} fill="currentColor" aria-hidden="true" />
							</a>
						</li>
					))
				}
			</ul>
		</footer>
	</main>
</Layout>
